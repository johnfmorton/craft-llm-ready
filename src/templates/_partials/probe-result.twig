{#- The result of one active cache probe (Tier 3): the verdict paragraph and
    any header evidence. Rendered inside the .llm-ready-probe-result container
    on page load, and re-rendered server-side by cache-check/probe for the
    AJAX response. The timestamp lives in the pane's meta row, not here.

    Whitespace-trimmed throughout: with no probe this template must produce
    zero output — not even a newline — so the container stays :empty and is
    dropped from the pane's flex stack.

    Variables: probe (array|null) -#}

{%- if probe -%}
    {%- if probe.verdict == 'hit' -%}
        <p class="llm-ready-probe-message warning with-icon">{{ probe.message }}</p>
    {%- elseif probe.verdict == 'error' -%}
        <p class="llm-ready-probe-message error">{{ probe.message }}</p>
    {%- else -%}
        <p class="llm-ready-probe-message">{{ probe.message }}</p>
    {%- endif -%}

    {%- if probe.evidence|length -%}
        <ul class="llm-ready-probe-evidence">
            {%- for item in probe.evidence -%}
                <li><code>{{ item }}</code></li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endif -%}
